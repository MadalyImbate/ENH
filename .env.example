# Endereço do backend ENH-KOGAS (sem barra final).
# Copie este ficheiro para ".env" e ajuste os valores para o seu ambiente.
#
# Produção:  https://prepago.enhkogas.co.mz
# Backend local (emulador Android): http://10.0.2.2:8000
# Backend local (simulador iOS):    http://127.0.0.1:8000
# Backend no PC, telemóvel físico:  http://<ip-da-sua-rede>:8000
API_HOST=https://prepago.enhkogas.co.mz

# Caminho da API móvel (alinhado com as rotas do backend Django).
API_PATH=/api/mobile/v1
